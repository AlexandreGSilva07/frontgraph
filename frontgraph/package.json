{
  "name": "frontgraph",
  "version": "0.1.0",
  "description": "Reference engine for FRONTGRAPH-SPEC — a living dependency graph embedded in your source code via @graph blocks: AST-derived truth, drift detection, token-budgeted agent briefs, and multi-agent coordination. CLI for humans, MCP for AI agents.",
  "keywords": [
    "ai-agents",
    "dependency-graph",
    "context-engineering",
    "mcp",
    "model-context-protocol",
    "architecture",
    "drift-detection",
    "multi-agent",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreGSilva07/frontgraph.git"
  },
  "homepage": "https://github.com/AlexandreGSilva07/frontgraph#readme",
  "bugs": "https://github.com/AlexandreGSilva07/frontgraph/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "frontgraph": "./dist/cli.js",
    "frontgraph-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    "./parser": "./dist/parser.js",
    "./graph": "./dist/graph.js",
    "./derive": "./dist/derive.js",
    "./sync": "./dist/sync.js",
    "./brief": "./dist/brief.js",
    "./staleness": "./dist/staleness.js",
    "./leases": "./dist/leases.js",
    "./work-orders": "./dist/work-orders.js",
    "./onboard": "./dist/onboard.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "COORDINATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "typescript": "~5.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^3.1.0"
  }
}
